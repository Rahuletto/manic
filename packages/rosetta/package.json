{
  "name": "@manicjs/rosetta",
  "version": "2.0.0-alpha.0",
  "description": "Translates Vite plugins to Manic plugins",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./preload": {
      "types": "./src/preload.ts",
      "import": "./src/preload.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx --bun tsc --noEmit",
    "lint": "bunx --bun oxlint --config ../../.oxlintrc.json .",
    "format:check": "bunx --bun oxfmt --check --config ../../.oxfmt.json ."
  },
  "dependencies": {
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^20.12.7",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/manic-js/manic#readme",
  "bugs": {
    "url": "https://github.com/manic-js/manic/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/manic-js/manic.git"
  }
}
