{
  "name": "@manicjs/monorepo",
  "version": "0.0.0",
  "dependencies": {},
  "description": "Manic v2 framework monorepo",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "bunx oxfmt --config .oxfmt.json .",
    "format:check": "bunx oxfmt --check --config .oxfmt.json .",
    "typecheck": "turbo typecheck",
    "ci:lint": "bunx oxlint --config .oxlintrc.json packages/manic/src packages/bundler/src packages/tui/src packages/create-manic packages/rosetta/src",
    "ci:format": "bunx oxfmt --check --config .oxfmt.json packages package.json turbo.json",
    "ci:typecheck": "turbo typecheck",
    "ci:test": "turbo test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "workspaces": [
    "packages/rosetta",
    "packages/manic",
    "packages/bundler",
    "packages/create-manic",
    "packages/tui"
  ],
  "packageManager": "bun@1.3.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "turbo": "^2.6.3",
    "typescript": "^6.0.3",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "@types/bun": "^1.3.13"
  }
}
